# Copy of the variable NAMES used by /home/ubuntu/eight-gar/.env on the host.
# The real file is generated by bootstrap.sh with random values, chmod 600, and is never committed.

# Postgres password for the dedicated "eightgar" database (compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=

# LiveKit API key/secret: shared by livekit-server (via LIVEKIT_KEYS) and the game server (token minting).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# HMAC key for guest session tokens (>= 32 random chars). Rotating it logs every player out.
SESSION_SECRET=

# Public URLs handed to browsers.
PUBLIC_ORIGIN=https://8gar.textbook.mn
LIVEKIT_URL=wss://livekit.textbook.mn

# Optional tunables (seconds unless noted); defaults live in server/src/config.ts.
#LOG_LEVEL=info
#TURN_SECONDS=180
#LEADER_SECONDS=180
#ROUND_REVIEW_SECONDS=10
#ROUND_OVER_SECONDS=60
#BOT_DELAY_MS=4000
#BOT_TAKEOVER_SECONDS=180
